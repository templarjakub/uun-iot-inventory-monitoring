# Server Configuration
PORT=3000
HOST=0.0.0.0
AWID=0123456789abcdef0123456789abcdef

# Persistence Layer Configuration
# Leave MONGODB_URI empty to use the built-in local persistent JSON store (./data/biot-store.json).
# For free cloud database, paste your MongoDB Atlas Free Tier (M0) connection string:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/biot_inventory?retryWrites=true&w=majority
MONGODB_URI=

# Measurement staleness threshold in minutes (BUC-12, BUC-13)
STALE_THRESHOLD_MINUTES=60
